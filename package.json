		"@vitest/coverage-v8": "5.1.0",
		"@vitest/ui": "5.1.0",
		"chromatic": "^18.14.2",
		"i18next-cli": "^1.87.0",
		"jsdom": "^31.0.0",
		"playwright": "latest",
		"shadcn": "^4.23.0",
		"storybook": "^10.6.6",
		"typescript": "~7.0.2",
