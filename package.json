		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-table": "^9.3.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"i18next": "^27.0.1",
