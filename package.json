{
	"name": "my-ui-catalog",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24.22.2"
	},
	"scripts": {
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check",
		"check:fix": "biome check --write",
		"prepare": "git config core.hooksPath .github/hooks",
		"test": "npx vitest",
		"test:run": "npx vitest run",
		"test:components": "npx vitest run --project components",
		"test:storybook": "npx vitest run --project storybook",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"i18n:check": "i18next-cli status",
		"i18n:check:unused": "i18next-cli status --unused"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
